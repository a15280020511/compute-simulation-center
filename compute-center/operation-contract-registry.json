{
  "schema_version": "compute-operation-contract-registry-v1",
  "status": "controlled-preview",
  "contracts": {
    "scenario_compare": {
      "output_schema": {
        "type": "object",
        "required": ["ranking", "best_scenario"],
        "properties": {
          "best_scenario": {"type": "string", "minLength": 1},
          "ranking": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "score", "values", "rank"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "score": {"type": "number"},
                "values": {"type": "object", "minProperties": 1},
                "rank": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "descriptive_statistics": {
      "output_schema": {
        "type": "object",
        "required": ["count", "mean", "median", "standard_deviation_population", "minimum", "maximum", "percentiles"],
        "properties": {
          "count": {"type": "integer", "minimum": 1},
          "mean": {"type": "number"},
          "median": {"type": "number"},
          "standard_deviation_population": {"type": "number", "minimum": 0},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "percentiles": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "sensitivity_analysis": {
      "output_schema": {
        "type": "object",
        "required": ["baseline_score", "ranking"],
        "properties": {
          "baseline_score": {"type": "number"},
          "ranking": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["variable", "low_score", "baseline_score", "high_score", "impact_range"],
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "monte_carlo": {
      "output_schema": {
        "type": "object",
        "required": ["iterations", "seed", "mean", "standard_deviation", "minimum", "maximum", "percentiles", "sensitivity"],
        "properties": {
          "iterations": {"type": "integer", "minimum": 100},
          "seed": {"type": "integer", "minimum": 0},
          "mean": {"type": "number"},
          "standard_deviation": {"type": "number", "minimum": 0},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "percentiles": {"type": "object"},
          "sensitivity": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "constrained_optimization": {
      "output_schema": {
        "type": "object",
        "required": ["success", "maximize", "objective_value", "solution", "solver_status", "solver_message"],
        "properties": {
          "success": {"const": true},
          "maximize": {"type": "boolean"},
          "objective_value": {"type": "number"},
          "solution": {"type": "object", "minProperties": 1},
          "solver_status": {"type": "integer"},
          "solver_message": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "pattern_discovery": {
      "output_schema": {
        "type": "object",
        "required": ["trend", "autocorrelations", "strongest_period_candidate", "change_point_candidate", "outlier_indices_z3", "summary", "warning"],
        "properties": {
          "trend": {"type": "object"},
          "autocorrelations": {"type": "array"},
          "strongest_period_candidate": {"type": "object"},
          "change_point_candidate": {"type": "object"},
          "outlier_indices_z3": {"type": "array"},
          "summary": {"type": "object"},
          "warning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "assumption_validation": {
      "output_schema": {
        "type": "object",
        "required": ["status", "checks", "observed", "warning"],
        "properties": {
          "status": {"enum": ["PASS", "WEAK", "HIGHLY_SENSITIVE", "CONFLICT", "INSUFFICIENT_DATA"]},
          "checks": {"type": "array"},
          "observed": {"type": "object"},
          "warning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "time_series_forecast": {
      "output_schema": {
        "type": "object",
        "required": ["selected_method", "candidate_scores", "forecast", "prediction_interval_95", "trend", "holdout_points"],
        "properties": {
          "selected_method": {"type": "object"},
          "candidate_scores": {"type": "array", "minItems": 2},
          "forecast": {"type": "array", "minItems": 1},
          "prediction_interval_95": {
            "type": "object",
            "required": ["lower", "upper"],
            "properties": {
              "lower": {"type": "array", "minItems": 1},
              "upper": {"type": "array", "minItems": 1}
            },
            "additionalProperties": true
          },
          "trend": {"type": "object"},
          "holdout_points": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    },
    "causal_screening": {
      "output_schema": {
        "type": "object",
        "required": ["method", "effect_estimate", "bootstrap_interval_95", "pretrend_gap", "pretrend_gap_standardized", "status", "warning"],
        "properties": {
          "method": {"const": "difference_in_differences_screening"},
          "effect_estimate": {"type": "number"},
          "bootstrap_interval_95": {"type": "array", "minItems": 2, "maxItems": 2},
          "pretrend_gap": {"type": "number"},
          "pretrend_gap_standardized": {"type": "number"},
          "status": {"enum": ["SUPPORTED", "WEAK", "CONFLICT", "INSUFFICIENT_DATA"]},
          "warning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "causal_policy_evaluation": {
      "output_schema": {
        "type": "object",
        "required": ["engine", "mode", "interpretation_boundary"],
        "properties": {
          "engine": {
            "type": "object",
            "required": ["name", "version", "network_used"],
            "properties": {
              "name": {"type": "string"},
              "version": {"type": "string"},
              "network_used": {"const": false}
            },
            "additionalProperties": true
          },
          "mode": {"type": "string", "minLength": 1},
          "interpretation_boundary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  }
}
