{
  "schema_version": "compute-dynamic-orchestration-policy-v3",
  "status": "experimental",
  "planner": "ortools-cp-sat",
  "graph_engine": "networkx",
  "network_policy": "deny",
  "model_calls": 0,
  "objective_text_routing_allowed": false,
  "structured_signals_only": true,
  "dynamic_stage_selection_allowed": true,
  "dynamic_operation_discovery_allowed": false,
  "ticket_supplied_code_allowed": false,
  "automatic_parallel_execution": false,
  "cycles_allowed": false,
  "maximum_stages": 8,
  "allowed_operations": [
    "scenario_compare",
    "sensitivity_analysis",
    "monte_carlo"
  ],
  "allowed_adapters": [
    "ticket_inputs",
    "scenario_ranking_to_sensitivity",
    "scenario_ranking_to_monte_carlo"
  ],
  "solver_policy": {
    "require_optimal_status": true,
    "max_time_seconds": 2.0,
    "num_search_workers": 1,
    "random_seed": 20260807,
    "exhaustive_cross_check_max_optional_nodes": 12
  },
  "selection_policy": {
    "sensitivity_min_scenarios": 3,
    "uncertainty_trigger_count": 2,
    "stage_penalty": {
      "sensitivity_analysis": 20,
      "monte_carlo": 30
    },
    "benefit": {
      "sensitivity_from_scenario_structure": 70,
      "sensitivity_from_uncertainty": 90,
      "sensitivity_from_formal_decision": 25,
      "monte_carlo_from_probabilistic_claim": 100,
      "monte_carlo_from_uncertainty": 90,
      "monte_carlo_from_formal_decision": 20
    },
    "hard_constraints": {
      "probabilistic_claim_requires_risk_simulation": true,
      "uncertainty_trigger_requires_risk_simulation": true,
      "high_stakes_uncertainty_requires_sensitivity": true,
      "high_stakes_uncertainty_requires_risk_simulation": true
    },
    "monte_carlo_iterations": {
      "exploratory": 3000,
      "formal": 5000,
      "high_stakes": 10000
    }
  }
}
