{
  "schema_version": "compute-dynamic-orchestration-policy-v5",
  "status": "controlled-preview",
  "planner": "ortools-cp-sat",
  "graph_engine": "networkx",
  "network_policy": "deny",
  "model_calls": 0,
  "objective_text_routing_allowed": false,
  "structured_signals_only": true,
  "dynamic_stage_selection_allowed": true,
  "dynamic_operation_discovery_allowed": false,
  "ticket_supplied_code_allowed": false,
  "automatic_parallel_execution": false,
  "cycles_allowed": false,
  "maximum_stages": 8,
  "production_activation": {
    "pipeline_id": "dynamic-auto-v1",
    "stage_id": "dynamic",
    "entry_operation": "scenario_compare"
  },
  "allowed_operations": [
    "scenario_compare",
    "descriptive_statistics",
    "sensitivity_analysis",
    "monte_carlo",
    "constrained_optimization"
  ],
  "allowed_adapters": [
    "ticket_inputs",
    "scenario_ranking_to_descriptive_statistics",
    "dynamic_scenario_ranking_to_sensitivity",
    "scenario_ranking_to_monte_carlo",
    "scenario_ranking_to_constrained_optimization"
  ],
  "solver_policy": {
    "require_optimal_status": true,
    "max_time_seconds": 2.0,
    "num_search_workers": 1,
    "random_seed": 20260807,
    "exhaustive_cross_check_max_optional_nodes": 12
  },
  "selection_policy": {
    "statistics_min_scenarios": 4,
    "sensitivity_min_scenarios": 3,
    "uncertainty_trigger_count": 2,
    "stage_rules": {
      "scenario_statistics": {
        "operation": "descriptive_statistics",
        "penalty": 10,
        "benefits": {
          "scenario_summary_eligible": 25,
          "formal_decision": 5
        },
        "eligible_all": ["scenario_summary_eligible"],
        "required_if_any": [],
        "required_if_all": []
      },
      "sensitivity": {
        "operation": "sensitivity_analysis",
        "penalty": 20,
        "benefits": {
          "scenario_structure": 70,
          "uncertainty_trigger": 90,
          "formal_decision": 25
        },
        "eligible_all": ["variable_variation"],
        "required_if_any": [],
        "required_if_all": [
          ["high_stakes_uncertainty", "variable_variation"]
        ]
      },
      "risk_simulation": {
        "operation": "monte_carlo",
        "penalty": 30,
        "benefits": {
          "probabilistic_claim": 100,
          "uncertainty_trigger": 90,
          "formal_decision": 20
        },
        "eligible_all": [],
        "required_if_any": [
          "probabilistic_claim",
          "uncertainty_trigger",
          "high_stakes_uncertainty"
        ],
        "required_if_all": []
      },
      "decision_optimization": {
        "operation": "constrained_optimization",
        "penalty": 35,
        "benefits": {
          "continuous_decision_optimization": 100,
          "formal_decision": 20,
          "high_stakes_uncertainty": 20
        },
        "eligible_all": ["continuous_decision_optimization"],
        "required_if_any": [],
        "required_if_all": []
      }
    },
    "monte_carlo_iterations": {
      "exploratory": 3000,
      "formal": 5000,
      "high_stakes": 10000
    }
  }
}
