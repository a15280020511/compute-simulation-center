{
  "schema_version": "compute-dynamic-reliability-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "reliability",
  "contracts": {
    "sample_statistics": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["count", "mean", "median", "standard_deviation_population", "minimum", "maximum", "percentiles"],
      "properties": {
        "count": {"type": "integer", "minimum": 2, "maximum": 100000},
        "mean": {"type": "number"},
        "median": {"type": "number"},
        "standard_deviation_population": {"type": "number", "exclusiveMinimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "percentiles": {"type": "object"}
      },
      "additionalProperties": true
    },
    "analytic_reliability": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "distribution", "mean", "standard_deviation", "threshold", "failure_tail", "failure_probability", "reliability_probability", "reliability_index_standard_normal", "engine", "external_data_fetches", "decision_support_only"],
      "properties": {
        "mode": {"const": "openturns_reliability_probability"},
        "distribution": {"const": "normal"},
        "mean": {"type": "number"},
        "standard_deviation": {"type": "number", "exclusiveMinimum": 0},
        "threshold": {"type": "number"},
        "failure_tail": {"enum": ["lower", "upper"]},
        "failure_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "reliability_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "reliability_index_standard_normal": {"type": "number"},
        "engine": {"type": "object"},
        "external_data_fetches": {"const": 0},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "monte_carlo_validation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["iterations", "seed", "mean", "standard_deviation", "minimum", "maximum", "percentiles", "threshold", "probability_below_threshold", "sensitivity"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 100, "maximum": 100000},
        "seed": {"type": "integer", "minimum": 0},
        "mean": {"type": "number"},
        "standard_deviation": {"type": "number", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "percentiles": {"type": "object"},
        "threshold": {"type": "number"},
        "probability_below_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "sensitivity": {"type": "array"}
      },
      "additionalProperties": true
    },
    "analytic_mc_agreement": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "external_data_fetches", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "external_data_fetches": {"const": 0},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "external_benchmark": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "external_data_fetches", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "external_data_fetches": {"const": 0},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
