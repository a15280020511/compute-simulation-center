{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/compute-simulation-center/compute-center/credibility-profile.schema.json",
  "title": "Risk-adjusted Compute Credibility Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["use_statement", "model_influence", "decision_consequence", "factor_levels"],
  "properties": {
    "use_statement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "model_influence": {"enum": ["low", "medium", "high"]},
    "decision_consequence": {"enum": ["low", "medium", "high"]},
    "factor_levels": {"type": "object", "maxProperties": 20, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4}},
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factor_ids", "sha256", "source"],
        "properties": {
          "factor_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence_type": {"enum": ["documentation", "independent_check", "domain_validation", "operational_feedback"]},
          "independent": {"type": "boolean"},
          "note": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "tailoring_rationale": {"type": "string", "maxLength": 4000},
    "assessment_owner": {"type": "string", "maxLength": 200},
    "assessment_date": {"type": "string", "maxLength": 100}
  }
}
