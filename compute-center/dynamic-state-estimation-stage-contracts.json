{
  "schema_version": "compute-dynamic-state-estimation-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "state-estimation",
  "contracts": {
    "bounded_linear_kalman_filter": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "state_dimension", "observation_dimension", "steps", "filtered_states", "covariance_diagonal", "mean_innovation_norm", "final_state", "fixed_offline_generic_state_estimation", "network_used", "model_calls", "live_feed_used", "individual_or_target_tracking_allowed", "decision_support_only"],
      "properties": {
        "mode": {"const": "bounded_linear_kalman_filter"},
        "state_dimension": {"type": "integer", "minimum": 1, "maximum": 20},
        "observation_dimension": {"type": "integer", "minimum": 1, "maximum": 20},
        "steps": {"type": "integer", "minimum": 1, "maximum": 10000},
        "filtered_states": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "number"}}},
        "covariance_diagonal": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "number", "minimum": 0}}},
        "mean_innovation_norm": {"type": "number", "minimum": 0},
        "final_state": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "fixed_offline_generic_state_estimation": {"const": true},
        "network_used": {"const": false},
        "model_calls": {"const": 0},
        "live_feed_used": {"const": false},
        "individual_or_target_tracking_allowed": {"const": false},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "realized_outcome_feedback": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "observations", "mae", "rmse", "bias", "early_period_mae", "late_period_mae", "drift_ratio_threshold", "drift_flag", "feedback_status", "network_used", "model_calls", "live_feed_used", "individual_or_target_tracking_allowed", "decision_support_only"],
      "properties": {
        "mode": {"const": "realized_outcome_feedback"},
        "observations": {"type": "integer", "minimum": 4},
        "mae": {"type": "number", "minimum": 0},
        "rmse": {"type": "number", "minimum": 0},
        "bias": {"type": "number"},
        "early_period_mae": {"type": "number", "minimum": 0},
        "late_period_mae": {"type": "number", "minimum": 0},
        "drift_ratio_threshold": {"type": "number", "exclusiveMinimum": 0},
        "drift_flag": {"type": "boolean"},
        "feedback_status": {"enum": ["WITHIN_THRESHOLD", "REVIEW_REQUIRED"]},
        "network_used": {"const": false},
        "model_calls": {"const": 0},
        "live_feed_used": {"const": false},
        "individual_or_target_tracking_allowed": {"const": false},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "benchmark_comparison": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "failed_candidates", "rows", "network_used", "model_calls", "live_feed_used", "individual_or_target_tracking_allowed", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "status": {"enum": ["PASS", "FAIL"]},
        "failed_candidates": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "network_used": {"const": false},
        "model_calls": {"const": 0},
        "live_feed_used": {"const": false},
        "individual_or_target_tracking_allowed": {"const": false},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
