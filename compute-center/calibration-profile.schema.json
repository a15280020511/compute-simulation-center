{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/compute-simulation-center/compute-center/calibration-profile.schema.json",
  "title": "Compute Calibration Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["backend", "parameters", "objective", "observations", "result_paths"],
  "properties": {
    "backend": {"enum": ["least_squares", "slsqp", "differential_evolution", "likelihood"]},
    "objective": {"enum": ["rmse", "weighted_rmse", "mae", "negative_log_likelihood", "multi_metric"]},
    "parameters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "initial", "minimum", "maximum", "input_path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
          "input_path": {"type": "string", "pattern": "^[A-Za-z0-9_.]+$", "maxLength": 300},
          "initial": {"type": "number"},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "integer": {"type": "boolean", "default": false},
          "prior": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "distribution": {"enum": ["uniform", "normal", "lognormal", "beta"]},
              "parameters": {"type": "object", "maxProperties": 10}
            }
          }
        }
      }
    },
    "observations": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"type": "number"}},
    "validation_observations": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"type": "number"}},
    "weights": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"type": "number", "exclusiveMinimum": 0}},
    "result_paths": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.]+$", "maxLength": 300}},
    "input_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "loss": {"enum": ["linear", "soft_l1", "huber", "cauchy", "arctan"]},
    "likelihood": {"enum": ["bernoulli", "binomial", "poisson", "negative_binomial", "normal", "lognormal", "gamma"]},
    "likelihood_options": {"type": "object", "maxProperties": 20},
    "multi_start": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_iterations": {"type": "integer", "minimum": 10, "maximum": 100000},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "uncertainty_methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["bootstrap", "profile_likelihood", "hessian", "multi_start", "near_optimal_set", "monte_carlo_propagation"]}}
  }
}
