{
  "schema_version": "compute-dynamic-capability-graph-v1",
  "status": "experimental",
  "graph_engine": "networkx",
  "selection_engine": "ortools-cp-sat",
  "nodes": [
    {
      "id": "scenarios",
      "operation": "scenario_compare",
      "adapter": "ticket_inputs",
      "role": "entry",
      "capabilities": ["discrete-alternative-comparison"]
    },
    {
      "id": "sensitivity",
      "operation": "sensitivity_analysis",
      "adapter": "scenario_ranking_to_sensitivity",
      "role": "optional-analysis",
      "capabilities": ["parameter-impact-ranking", "robustness-screening"]
    },
    {
      "id": "risk_simulation",
      "operation": "monte_carlo",
      "adapter": "scenario_ranking_to_monte_carlo",
      "role": "optional-analysis",
      "capabilities": ["probabilistic-risk", "uncertainty-propagation"]
    }
  ],
  "precedence": [
    ["scenarios", "sensitivity"],
    ["scenarios", "risk_simulation"],
    ["sensitivity", "risk_simulation"]
  ],
  "safety": {
    "dynamic_operation_discovery_allowed": false,
    "ticket_supplied_nodes_allowed": false,
    "ticket_supplied_edges_allowed": false,
    "cycles_allowed": false,
    "automatic_parallel_execution": false
  }
}
