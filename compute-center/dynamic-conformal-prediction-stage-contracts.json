{
  "schema_version": "compute-dynamic-conformal-prediction-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "conformal-prediction",
  "contracts": {
    "mapie_conformal_interval": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "confidence", "cv", "predictions", "lower_bounds", "upper_bounds", "mean_interval_width", "coverage_claim", "engine"],
      "properties": {
        "mode": {"const": "mapie_conformal_interval"},
        "confidence": {"type": "number", "minimum": 0.5, "exclusiveMaximum": 1.0},
        "cv": {"type": "integer", "minimum": 2, "maximum": 10},
        "predictions": {"type": "array", "minItems": 1, "maxItems": 1000},
        "lower_bounds": {"type": "array", "minItems": 1, "maxItems": 1000},
        "upper_bounds": {"type": "array", "minItems": 1, "maxItems": 1000},
        "mean_interval_width": {"type": "number", "minimum": 0.0},
        "coverage_claim": {"type": "string"},
        "engine": {"type": "object"}
      },
      "additionalProperties": true
    },
    "prediction_interval_validation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "observations", "nominal_coverage", "empirical_coverage", "coverage_error", "average_interval_width", "median_interval_width", "mean_interval_score", "below_interval_rate", "above_interval_rate"],
      "properties": {
        "mode": {"const": "prediction_interval_validation"},
        "observations": {"type": "integer", "minimum": 1, "maximum": 20000},
        "nominal_coverage": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "empirical_coverage": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "coverage_error": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "average_interval_width": {"type": "number", "minimum": 0.0},
        "median_interval_width": {"type": "number", "minimum": 0.0},
        "mean_interval_score": {"type": "number", "minimum": 0.0},
        "below_interval_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "above_interval_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "additionalProperties": true
    },
    "interval_width_consistency_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {"mode": {"const": "benchmark_comparison"}, "candidate_count": {"const": 1}, "passed": {"type": "integer", "minimum": 0, "maximum": 1}, "failed": {"type": "integer", "minimum": 0, "maximum": 1}, "status": {"enum": ["PASS", "FAIL"]}, "rows": {"type": "array", "minItems": 1, "maxItems": 1}, "decision_support_only": {"const": true}},
      "additionalProperties": true
    },
    "interval_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {"mode": {"const": "benchmark_comparison"}, "candidate_count": {"type": "integer", "minimum": 1, "maximum": 3}, "passed": {"type": "integer", "minimum": 0, "maximum": 3}, "failed": {"type": "integer", "minimum": 0, "maximum": 3}, "status": {"enum": ["PASS", "FAIL"]}, "rows": {"type": "array", "minItems": 1, "maxItems": 3}, "decision_support_only": {"const": true}},
      "additionalProperties": true
    },
    "realized_outcome_feedback": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "observations", "mae", "rmse", "bias", "median_absolute_error", "early_period_mae", "late_period_mae", "late_to_early_mae_ratio", "drift_ratio_threshold", "drift_flag", "feedback_status"],
      "properties": {
        "mode": {"const": "realized_outcome_feedback"},
        "observations": {"type": "integer", "minimum": 4, "maximum": 20000},
        "mae": {"type": "number", "minimum": 0.0},
        "rmse": {"type": "number", "minimum": 0.0},
        "bias": {"type": "number"},
        "median_absolute_error": {"type": "number", "minimum": 0.0},
        "early_period_mae": {"type": "number", "minimum": 0.0},
        "late_period_mae": {"type": "number", "minimum": 0.0},
        "late_to_early_mae_ratio": {"type": ["number", "null"]},
        "drift_ratio_threshold": {"type": "number", "exclusiveMinimum": 0.0},
        "drift_flag": {"type": "boolean"},
        "feedback_status": {"enum": ["WITHIN_THRESHOLD", "REVIEW_REQUIRED"]}
      },
      "additionalProperties": true
    },
    "point_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {"mode": {"const": "benchmark_comparison"}, "candidate_count": {"type": "integer", "minimum": 1, "maximum": 2}, "passed": {"type": "integer", "minimum": 0, "maximum": 2}, "failed": {"type": "integer", "minimum": 0, "maximum": 2}, "status": {"enum": ["PASS", "FAIL"]}, "rows": {"type": "array", "minItems": 1, "maxItems": 2}, "decision_support_only": {"const": true}},
      "additionalProperties": true
    }
  }
}
