{
  "schema_version": "compute-dynamic-factor-regression-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "factor-regression",
  "contracts": {
    "factor_regression": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "observations", "parameters", "r_squared", "adjusted_r_squared", "covariance_type", "residual_volatility", "decision_support_only"],
      "properties": {
        "mode": {"const": "factor_regression"},
        "observations": {"type": "integer", "minimum": 10, "maximum": 20000},
        "parameters": {"type": "object", "minProperties": 1, "maxProperties": 21},
        "r_squared": {"type": "number"},
        "adjusted_r_squared": {"type": "number"},
        "covariance_type": {"enum": ["HAC", "HC0", "HC1", "HC2", "HC3", "nonrobust"]},
        "residual_volatility": {"type": "number", "minimum": 0.0},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "numpy_exact_regression_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"type": "integer", "minimum": 3, "maximum": 23},
        "passed": {"type": "integer", "minimum": 0, "maximum": 23},
        "failed": {"type": "integer", "minimum": 0, "maximum": 23},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 3, "maxItems": 23},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "r_squared_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "residual_volatility_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
