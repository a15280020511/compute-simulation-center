{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SageMath Compute Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "provider",
    "operation",
    "objective",
    "inputs",
    "data_policy",
    "quality_profile",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "provider": {
      "const": "compute-sagemath"
    },
    "operation": {
      "const": "symbolic_mathematics"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "inputs": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 7,
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": [
            "simplify",
            "solve",
            "differentiate",
            "integrate",
            "matrix_analysis",
            "number_theory"
          ]
        },
        "variables": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}$"
          }
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "variable": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "matrix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "number"
            }
          }
        },
        "action": {
          "enum": ["factor", "is_prime", "gcd", "lcm", "euler_phi"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": -1000000000000000000,
            "maximum": 1000000000000000000
          }
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data"],
      "properties": {
        "classification": {
          "const": "public-or-user-supplied-nonpersonal"
        },
        "contains_personal_data": {
          "const": false
        }
      }
    },
    "quality_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_class"],
      "properties": {
        "decision_class": {
          "enum": ["exploratory", "formal"]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds"],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 90
        }
      }
    }
  }
}
