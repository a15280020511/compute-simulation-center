{
  "schema_version": "compute-dynamic-process-mining-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "process-mining",
  "contracts": {
    "directly_follows_discovery": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "case_count", "event_count", "activity_count", "directly_follows_edges", "start_activities", "end_activities", "engine"],
      "properties": {
        "mode": {"const": "pm4py_directly_follows"},
        "case_count": {"type": "integer", "minimum": 1, "maximum": 2000},
        "event_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "activity_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "directly_follows_edges": {"type": "array", "maxItems": 10000},
        "start_activities": {"type": "object"},
        "end_activities": {"type": "object"},
        "engine": {"type": "object"}
      },
      "additionalProperties": true
    },
    "workflow_graph_summary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "node_count", "edge_count", "directed", "component_count", "largest_component_size", "ranking", "pagerank_iterations", "algorithm"],
      "properties": {
        "mode": {"const": "large_graph_summary"},
        "node_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "edge_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "directed": {"const": true},
        "component_count": {"type": "integer", "minimum": 1},
        "largest_component_size": {"type": "integer", "minimum": 1},
        "ranking": {"type": "array"},
        "pagerank_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
        "algorithm": {"const": "sparse-components-degree-and-bounded-pagerank"}
      },
      "additionalProperties": true
    },
    "topology_consistency_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 2},
        "passed": {"type": "integer", "minimum": 0, "maximum": 2},
        "failed": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 2, "maxItems": 2},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "process_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 4},
        "passed": {"type": "integer", "minimum": 0, "maximum": 4},
        "failed": {"type": "integer", "minimum": 0, "maximum": 4},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 4},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
