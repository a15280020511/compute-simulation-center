{
  "schema_version": "compute-dynamic-transport-routing-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "transport-routing",
  "contracts": {
    "aequilibrae_shortest_path": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "origin", "destination", "path_nodes", "path_links", "total_cost", "link_count", "network_link_count", "engine"],
      "properties": {
        "mode": {"const": "aequilibrae_shortest_path"},
        "origin": {"type": "integer", "minimum": 1},
        "destination": {"type": "integer", "minimum": 1},
        "path_nodes": {"type": "array", "minItems": 2, "maxItems": 5001, "items": {"type": "integer"}},
        "path_links": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"type": "integer", "minimum": 1}},
        "total_cost": {"type": "number", "minimum": 0.0},
        "link_count": {"type": "integer", "minimum": 1, "maximum": 5000},
        "network_link_count": {"type": "integer", "minimum": 1, "maximum": 5000},
        "engine": {"type": "object"}
      },
      "additionalProperties": true
    },
    "networkx_exact_route_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 2},
        "passed": {"type": "integer", "minimum": 0, "maximum": 2},
        "failed": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 2, "maxItems": 2},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "route_cost_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "route_hop_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
