{
  "schema_version": "compute-dynamic-control-response-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "control-response",
  "contracts": {
    "control_step_response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "time", "response", "final_value", "peak_value", "peak_time", "overshoot_percent", "stable_numeric_response", "engine"],
      "properties": {
        "mode": {"const": "control_step_response"},
        "time": {"type": "array", "minItems": 10, "maxItems": 1000, "items": {"type": "number"}},
        "response": {"type": "array", "minItems": 10, "maxItems": 1000, "items": {"type": "number"}},
        "final_value": {"type": "number"},
        "peak_value": {"type": "number"},
        "peak_time": {"type": "number", "minimum": 0.0},
        "overshoot_percent": {"type": "number", "minimum": 0.0},
        "stable_numeric_response": {"type": "boolean"},
        "engine": {"type": "object"}
      },
      "additionalProperties": true
    },
    "tail_response_statistics": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["count", "mean", "median", "standard_deviation_population", "minimum", "maximum", "percentiles"],
      "properties": {
        "count": {"type": "integer", "minimum": 10},
        "mean": {"type": "number"},
        "median": {"type": "number"},
        "standard_deviation_population": {"type": "number", "minimum": 0.0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "percentiles": {"type": "object"}
      },
      "additionalProperties": true
    },
    "tail_stability_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "dc_gain_consistency_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "control_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "passed": {"type": "integer", "minimum": 0, "maximum": 3},
        "failed": {"type": "integer", "minimum": 0, "maximum": 3},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 3},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
