    },
    "topology_consistency_audit": {
      "operation": "finance_decision_analysis",
      "mode": "benchmark_comparison",
      "adapter": "process_graph_to_consistency_audit"
    },
    "process_target_audit": {
      "operation": "finance_decision_analysis",
      "mode": "benchmark_comparison",
      "adapter": "process_to_target_audit"
    }
  },
  "precedence": [
