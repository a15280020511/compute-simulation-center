{
  "schema_version": "compute-orchestration-capability-graph-v1",
  "status": "experimental",
  "graph_engine": "networkx",
  "optimizer": "ortools-cp-sat",
  "network_policy": "deny",
  "automatic_parallel_execution": false,
  "cycles_allowed": false,
  "nodes": {
    "scenarios": {
      "operation": "scenario_compare",
      "adapter": "ticket_inputs",
      "role": "entry",
      "provides": ["scenario_ranking", "scenario_values"],
      "requires": [],
      "base_compute_cost": 5
    },
    "sensitivity": {
      "operation": "sensitivity_analysis",
      "adapter": "scenario_ranking_to_sensitivity",
      "role": "analysis",
      "provides": ["sensitivity_ranking"],
      "requires": ["scenario_ranking"],
      "base_compute_cost": 20
    },
    "risk_simulation": {
      "operation": "monte_carlo",
      "adapter": "scenario_ranking_to_monte_carlo",
      "role": "analysis",
      "provides": ["risk_distribution", "risk_sensitivity"],
      "requires": ["scenario_ranking"],
      "base_compute_cost": 30
    }
  },
  "edges": [
    {
      "from": "scenarios",
      "to": "sensitivity",
      "adapter": "scenario_ranking_to_sensitivity"
    },
    {
      "from": "scenarios",
      "to": "risk_simulation",
      "adapter": "scenario_ranking_to_monte_carlo"
    },
    {
      "from": "sensitivity",
      "to": "risk_simulation",
      "adapter": "scenario_ranking_to_monte_carlo",
      "context_dependency": "scenarios"
    }
  ]
}
