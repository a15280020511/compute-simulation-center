{
  "schema_version": "compute-dynamic-capital-budgeting-policy-v1",
  "status": "controlled-preview",
  "family": "capital-budgeting",
  "declared_operation": "finance_decision_analysis",
  "declared_mode": "capital_budgeting",
  "planner": "ortools-cp-sat",
  "graph_engine": "networkx",
  "network_policy": "deny",
  "model_calls": 0,
  "objective_text_routing_allowed": false,
  "structured_signals_only": true,
  "dynamic_operation_discovery_allowed": false,
  "ticket_supplied_code_allowed": false,
  "automatic_parallel_execution": false,
  "cycles_allowed": false,
  "branching_allowed": true,
  "maximum_stages": 3,
  "allowed_operations": ["finance_decision_analysis"],
  "allowed_entry_modes": ["capital_budgeting"],
  "allowed_adapters": [
    "capital_budget_ticket_to_primary",
    "capital_budget_to_independent_exact_audit",
    "capital_budget_to_target_audit"
  ],
  "solver_policy": {
    "require_optimal_status": true,
    "num_search_workers": 1,
    "random_seed": 0,
    "max_time_seconds": 5.0,
    "exhaustive_cross_check_max_optional_nodes": 8
  },
  "selection_policy": {
    "stage_rules": {
      "independent_exact_capital_budget_audit": {
        "penalty": 5,
        "benefits": {"exact_capital_budget_consistency_required": 220},
        "required_if_any": ["exact_capital_budget_consistency_required"]
      },
      "capital_budget_target_audit": {
        "penalty": 5,
        "benefits": {"capital_budget_target_available": 140},
        "eligible_all": ["capital_budget_target_available"],
        "required_if_any": ["capital_budget_target_available"]
      }
    }
  }
}
