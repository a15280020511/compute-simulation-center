{
  "schema_version": "compute-systems-matrix-v1",
  "status": "production-control-plane",
  "purpose": "Map every allowlisted compute operation into a systems-thinking lifecycle without adding a new runtime platform.",
  "selection_owner": "gpts-usage-center",
  "runtime_network_policy": "deny",
  "principles": [
    "separate observation, mechanism, state evolution, decision and validation",
    "treat feedback, delay, nonlinearity and adaptation as explicit model properties",
    "require evidence and uncertainty gates before decision publication",
    "compose only fixed allowlisted operations; never execute ticket-supplied code",
    "prefer the smallest sufficient method chain over a universal heavyweight stack"
  ],
  "lifecycle_stages": [
    "formulate",
    "estimate_or_calibrate",
    "simulate_or_optimize",
    "stress_and_validate",
    "realized_outcome_feedback"
  ],
  "required_gate_catalog": {
    "input_quality": "types, units, time, geography and missingness are explicit",
    "assumption_register": "non-observed values and mechanisms are declared",
    "constraint_feasibility": "hard constraints are checked before optimization or publication",
    "identifiability": "parameters or causal effects are distinguishable from available evidence",
    "uncertainty": "sampling, parameter, scenario or model uncertainty is represented",
    "calibration": "predictions or parameters are compared with observed outcomes where applicable",
    "stress_test": "boundary, adversarial and regime-break scenarios are evaluated",
    "external_validation": "holdout, frozen benchmark or realized outcome is used",
    "feedback_monitoring": "drift and realized-outcome errors are recorded"
  },
  "routes": {
