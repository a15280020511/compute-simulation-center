{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/a15280020511/test/compute-center/mechanism-register.schema.json",
  "title":"Phenomena and Mechanism Coverage Register",
  "type":"array",
  "maxItems":200,
  "items":{"type":"object","additionalProperties":false,"required":["mechanism_id","statement","importance","inclusion_status","rationale"],"properties":{"mechanism_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"statement":{"type":"string","minLength":1,"maxLength":4000},"importance":{"enum":["low","medium","high","critical"]},"inclusion_status":{"enum":["included","approximated","excluded","unknown"]},"rationale":{"type":"string","minLength":1,"maxLength":4000},"linked_assumption_ids":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","maxLength":128}},"validation_evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"omission_effect":{"enum":["none","underestimate","overestimate","direction_unknown"]},"alternative_model_id":{"type":"string","maxLength":200},"falsification_test":{"type":"string","maxLength":4000}}}
}
