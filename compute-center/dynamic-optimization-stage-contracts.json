{
  "schema_version": "compute-dynamic-optimization-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "optimization",
  "contracts": {
    "primary_optimization": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "status", "objective_value", "maximize", "variables", "best_bound", "constraint_count", "optimality_not_guaranteed", "decision_support_only"],
      "properties": {
        "mode": {"const": "mixed_integer_optimization"},
        "status": {"enum": ["optimal", "feasible_time_limited"]},
        "objective_value": {"type": "number"},
        "maximize": {"type": "boolean"},
        "variables": {"type": "object"},
        "best_bound": {"type": "number"},
        "constraint_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "optimality_not_guaranteed": {"type": "boolean"},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "independent_relaxation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "decision", "objective_value", "termination", "engines", "decision_support_only"],
      "properties": {
        "mode": {"const": "algebraic_resource_optimization"},
        "decision": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "number"}},
        "objective_value": {"type": "number"},
        "termination": {"type": "string"},
        "engines": {"type": "object"},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "relaxation_bound_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "external_objective_benchmark": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
