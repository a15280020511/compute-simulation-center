{
  "schema_version": "compute-dynamic-global-sensitivity-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "global-sensitivity",
  "contracts": {
    "salib_sobol_sensitivity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "base_samples", "evaluations", "seed", "ranking", "output_distribution", "fixed_model_only", "decision_support_only"],
      "properties": {
        "mode": {"const": "sobol_sensitivity"},
        "base_samples": {"type": "integer", "minimum": 64, "maximum": 8192},
        "evaluations": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "ranking": {"type": "array", "minItems": 2, "maxItems": 10},
        "output_distribution": {
          "type": "object",
          "required": ["mean", "standard_deviation", "p05", "p50", "p95"],
          "properties": {
            "mean": {"type": "number"},
            "standard_deviation": {"type": "number", "minimum": 0.0},
            "p05": {"type": "number"},
            "p50": {"type": "number"},
            "p95": {"type": "number"}
          },
          "additionalProperties": true
        },
        "fixed_model_only": {"const": true},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "exact_index_consistency_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"type": "integer", "minimum": 4, "maximum": 20},
        "passed": {"type": "integer", "minimum": 0, "maximum": 20},
        "failed": {"type": "integer", "minimum": 0, "maximum": 20},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 4, "maxItems": 20},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "exact_moment_consistency_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 2},
        "passed": {"type": "integer", "minimum": 0, "maximum": 2},
        "failed": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 2, "maxItems": 2},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "sensitivity_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "passed": {"type": "integer", "minimum": 0, "maximum": 10},
        "failed": {"type": "integer", "minimum": 0, "maximum": 10},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 10},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
