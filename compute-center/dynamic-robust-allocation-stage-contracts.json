{
  "schema_version": "compute-dynamic-robust-allocation-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "robust-allocation",
  "contracts": {
    "rsome_robust_allocation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "asset_names", "weights", "scenario_returns", "worst_case_return", "mean_return", "scenario_count", "engine"],
      "properties": {
        "mode": {"const": "rsome_robust_allocation"},
        "asset_names": {"type": "array", "minItems": 2, "maxItems": 50},
        "weights": {"type": "array", "minItems": 2, "maxItems": 50},
        "scenario_returns": {"type": "array", "minItems": 2, "maxItems": 500},
        "worst_case_return": {"type": "number"},
        "mean_return": {"type": "number"},
        "scenario_count": {"type": "integer", "minimum": 2, "maximum": 500},
        "engine": {"type": "object"}
      },
      "additionalProperties": true
    },
    "ortools_maximin_crosscheck": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "status", "objective_value", "maximize", "variables", "best_bound", "constraint_count", "optimality_not_guaranteed"],
      "properties": {
        "mode": {"const": "mixed_integer_optimization"},
        "status": {"enum": ["optimal", "feasible_time_limited"]},
        "objective_value": {"type": "number"},
        "maximize": {"const": true},
        "variables": {"type": "object"},
        "best_bound": {"type": "number"},
        "constraint_count": {"type": "integer", "minimum": 3, "maximum": 1000},
        "optimality_not_guaranteed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "worst_case_objective_consistency_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {"mode": {"const": "benchmark_comparison"}, "candidate_count": {"const": 1}, "passed": {"type": "integer", "minimum": 0, "maximum": 1}, "failed": {"type": "integer", "minimum": 0, "maximum": 1}, "status": {"enum": ["PASS", "FAIL"]}, "rows": {"type": "array", "minItems": 1, "maxItems": 1}, "decision_support_only": {"const": true}},
      "additionalProperties": true
    },
    "allocation_feasibility_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {"mode": {"const": "benchmark_comparison"}, "candidate_count": {"const": 3}, "passed": {"type": "integer", "minimum": 0, "maximum": 3}, "failed": {"type": "integer", "minimum": 0, "maximum": 3}, "status": {"enum": ["PASS", "FAIL"]}, "rows": {"type": "array", "minItems": 3, "maxItems": 3}, "decision_support_only": {"const": true}},
      "additionalProperties": true
    },
    "allocation_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {"mode": {"const": "benchmark_comparison"}, "candidate_count": {"type": "integer", "minimum": 1, "maximum": 3}, "passed": {"type": "integer", "minimum": 0, "maximum": 3}, "failed": {"type": "integer", "minimum": 0, "maximum": 3}, "status": {"enum": ["PASS", "FAIL"]}, "rows": {"type": "array", "minItems": 1, "maxItems": 3}, "decision_support_only": {"const": true}},
      "additionalProperties": true
    }
  }
}
