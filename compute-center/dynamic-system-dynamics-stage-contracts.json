{
  "schema_version": "compute-dynamic-system-dynamics-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "system-dynamics",
  "contracts": {
    "primary_simulation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "engine", "history"],
      "properties": {
        "mode": {"enum": ["stock_flow", "feedback_delay", "policy_switch", "coupled_capacity", "resource_depletion", "adoption_saturation"]},
        "engine": {"type": "object"},
        "history": {"type": "array", "minItems": 1, "maxItems": 102},
        "decision_support_only": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "trajectory_statistics": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["count", "mean", "median", "standard_deviation_population", "minimum", "maximum", "percentiles"],
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "mean": {"type": "number"},
        "median": {"type": "number"},
        "standard_deviation_population": {"type": "number", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "percentiles": {"type": "object"}
      },
      "additionalProperties": true
    },
    "robustness_simulation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "engine", "history"],
      "properties": {
        "mode": {"enum": ["feedback_delay", "policy_switch", "coupled_capacity", "resource_depletion", "adoption_saturation"]},
        "engine": {"type": "object"},
        "history": {"type": "array", "minItems": 1, "maxItems": 102}
      },
      "additionalProperties": true
    },
    "robustness_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "external_final_benchmark": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
