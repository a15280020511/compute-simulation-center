{
  "schema_version": "compute-dynamic-drift-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "drift",
  "contracts": {
    "distribution_drift": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "reference_rows", "current_rows", "drifted_columns_screen", "drift_share_screen", "columns", "engine", "network_used"],
      "properties": {
        "mode": {"const": "evidently_data_drift"},
        "reference_rows": {"type": "integer", "minimum": 20, "maximum": 5000},
        "current_rows": {"type": "integer", "minimum": 20, "maximum": 5000},
        "drifted_columns_screen": {"type": "integer", "minimum": 0, "maximum": 30},
        "drift_share_screen": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "columns": {"type": "array", "minItems": 2, "maxItems": 30},
        "engine": {"type": "object"},
        "network_used": {"const": false}
      },
      "additionalProperties": true
    },
    "adwin_cross_check": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "observations", "delta", "drift_indices", "drift_count", "engine", "network_used"],
      "properties": {
        "mode": {"const": "river_adwin_drift"},
        "observations": {"type": "integer", "minimum": 20, "maximum": 50000},
        "delta": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 0.5},
        "drift_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "drift_count": {"type": "integer", "minimum": 0},
        "engine": {"type": "object"},
        "network_used": {"const": false}
      },
      "additionalProperties": true
    },
    "change_point_cross_check": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "change_points", "terminal_index", "engine"],
      "properties": {
        "mode": {"const": "change_point_detection"},
        "change_points": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "terminal_index": {"type": "integer", "minimum": 20},
        "engine": {"type": "object"}
      },
      "additionalProperties": true
    },
    "drift_share_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
