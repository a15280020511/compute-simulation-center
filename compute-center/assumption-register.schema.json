{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/a15280020511/test/compute-center/assumption-register.schema.json",
  "title":"Compute Center Assumption Register",
  "type":"array",
  "maxItems":200,
  "items":{
    "type":"object",
    "additionalProperties":false,
    "required":["assumption_id","type","statement","source_type","basis","confidence","calibration_status"],
    "properties":{
      "assumption_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
      "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "status":{"enum":["proposed","reviewed","approved","calibrated","validated","invalidated","retired"]},
      "type":{"enum":["structural","behavioral","parameter","boundary","data","measurement","numerical","causal","scenario","policy"]},
      "uncertainty_type":{"enum":["epistemic","aleatory","mixed","deterministic"]},
      "statement":{"type":"string","minLength":1,"maxLength":4000},
      "intended_use":{"type":"string","maxLength":4000},
      "owner":{"type":"string","maxLength":200},
      "approver":{"type":"string","maxLength":200},
      "linked_parameter":{"type":["string","null"],"maxLength":200},
      "linked_parameters":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","maxLength":200}},
      "linked_model_ids":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","maxLength":200}},
      "linked_operations":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","maxLength":100}},
      "linked_constraint_ids":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","maxLength":200}},
      "linked_scenario_ids":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","maxLength":200}},
      "dependencies":{"type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"string","maxLength":128}},
      "correlation_group":{"type":"string","maxLength":200},
      "source_type":{"enum":["observation","public_source","historical","benchmark","expert_elicitation","user_assumption","proxy","gpts_assumption"]},
      "basis":{"type":"string","minLength":1,"maxLength":4000},
      "confidence":{"enum":["low","medium","high"]},
      "criticality":{"enum":["low","medium","high","critical"]},
      "evidence_strength":{"enum":["none","weak","moderate","strong"]},
      "minimum":{"type":"number"},
      "maximum":{"type":"number"},
      "distribution":{"enum":["constant","uniform","triangular","normal","lognormal","beta","categorical","empirical","scenario_set"]},
      "mode":{"type":"number"},
      "mean":{"type":"number"},
      "standard_deviation":{"type":"number","exclusiveMinimum":0},
      "falsification_test":{"type":"string","maxLength":4000},
      "invalid_when":{"type":"string","maxLength":4000},
      "reducibility_plan":{"type":"string","maxLength":4000},
      "fallback_action":{"type":"string","maxLength":4000},
      "sensitivity_required":{"type":"boolean"},
      "stress_test_required":{"type":"boolean"},
      "sensitivity_rank":{"type":["integer","null"],"minimum":1},
      "calibration_status":{"enum":["uncalibrated","calibrated","validated","invalidated"]},
      "evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
      "created_at":{"type":"string","maxLength":100},
      "last_reviewed_at":{"type":"string","maxLength":100},
      "review_due_at":{"type":"string","maxLength":100},
      "supersedes":{"type":"string","maxLength":128},
      "content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
    },
    "allOf":[
      {"if":{"properties":{"confidence":{"const":"low"}}},"then":{"required":["distribution"]}},
      {"if":{"properties":{"uncertainty_type":{"enum":["epistemic","mixed"]},"criticality":{"enum":["high","critical"]}},"required":["uncertainty_type","criticality"]},"then":{"required":["falsification_test","invalid_when"]}}
    ]
  }
}
