{
  "schema_version": "compute-dynamic-assignment-optimization-stage-contracts-v1",
  "status": "controlled-preview",
  "family": "assignment-optimization",
  "contracts": {
    "assignment_optimization": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "objective_value", "maximize", "assignments", "unassigned_workers", "unassigned_tasks", "decision_support_only"],
      "properties": {
        "mode": {"const": "assignment_optimization"},
        "objective_value": {"type": "number"},
        "maximize": {"type": "boolean"},
        "assignments": {"type": "array", "minItems": 1, "maxItems": 100},
        "unassigned_workers": {"type": "array", "maxItems": 100},
        "unassigned_tasks": {"type": "array", "maxItems": 100},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "scipy_exact_assignment_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 2},
        "passed": {"type": "integer", "minimum": 0, "maximum": 2},
        "failed": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 2, "maxItems": 2},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    },
    "objective_target_audit": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["mode", "candidate_count", "passed", "failed", "status", "rows", "decision_support_only"],
      "properties": {
        "mode": {"const": "benchmark_comparison"},
        "candidate_count": {"const": 1},
        "passed": {"type": "integer", "minimum": 0, "maximum": 1},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "FAIL"]},
        "rows": {"type": "array", "minItems": 1, "maxItems": 1},
        "decision_support_only": {"const": true}
      },
      "additionalProperties": true
    }
  }
}
